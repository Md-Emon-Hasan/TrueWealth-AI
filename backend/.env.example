# Groq API Key (Required for LLM)
GROQ_API_KEY=your_groq_api_key_here

# Rate limiting (optional, defaults shown)
RATE_LIMIT_ENABLED=true
RATE_LIMIT=20/minute

# Cache TTLs in seconds (optional, defaults shown)
RAG_CACHE_TTL=1800
MARKET_QUOTE_CACHE_TTL=45
NEWS_CACHE_TTL=600
DDG_CACHE_TTL=1200
ANSWER_CACHE_TTL=120

# Outbound tool network behavior (optional, defaults shown)
TOOL_TIMEOUT_SECONDS=8
TOOL_RETRY_LIMIT=1

# Persistence (optional, defaults to backend/app/truewealth.sqlite3)
SQLITE_PATH=

# Model gateway, all Groq-hosted (optional, defaults shown)
MODEL_ANSWER=openai/gpt-oss-120b
MODEL_REASONING=llama-3.3-70b-versatile
MODEL_CLASSIFY=llama-3.1-8b-instant
GATEWAY_CACHE_TTL=300
GATEWAY_RETRY_LIMIT=1

# market desk fan-out (optional, default shown)
MARKET_DESK_TIMEOUT_SECONDS=15

# due diligence (optional, defaults shown)
DUE_DILIGENCE_SKIP_WHEN_CLEAN=true
DUE_DILIGENCE_MAX_REVISIONS=1

# portfolio analysis (optional, defaults shown)
PORTFOLIO_HISTORY_PERIOD=6mo
PORTFOLIO_CONCENTRATION_THRESHOLD_PCT=40

# semantic memory, on top of MEMORY_LIMIT (optional, default shown)
SEMANTIC_MEMORY_TOP_K=3

# human review queue triggers (optional, defaults shown)
REVIEW_ON_HIGH_RISK=true
REVIEW_ON_COMPLIANCE_VIOLATION=true
REVIEW_ON_UNSUPPORTED_FIGURES=true
REVIEW_ON_MARKET_DATA_UNAVAILABLE=true
