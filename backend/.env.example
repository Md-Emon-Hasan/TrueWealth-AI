# Groq API Key (Required for LLM)
GROQ_API_KEY=your_groq_api_key_here

# Rate limiting (optional, defaults shown)
RATE_LIMIT_ENABLED=true
RATE_LIMIT=20/minute

# Cache TTLs in seconds (optional, defaults shown)
RAG_CACHE_TTL=1800
MARKET_QUOTE_CACHE_TTL=45
NEWS_CACHE_TTL=600
DDG_CACHE_TTL=1200
ANSWER_CACHE_TTL=120

# Outbound tool network behavior (optional, defaults shown)
TOOL_TIMEOUT_SECONDS=8
TOOL_RETRY_LIMIT=1

# Persistence (optional, defaults to backend/app/truewealth.sqlite3)
SQLITE_PATH=

# Model gateway, all Groq-hosted (optional, defaults shown)
MODEL_ANSWER=openai/gpt-oss-120b
MODEL_REASONING=llama-3.3-70b-versatile
MODEL_CLASSIFY=llama-3.1-8b-instant
GATEWAY_CACHE_TTL=300
GATEWAY_RETRY_LIMIT=1
